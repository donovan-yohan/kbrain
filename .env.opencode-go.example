# kbrain + OpenCode Go example configuration (v0.27 AI Gateway)
#
# Copy to .env and fill in the required placeholders below:
#   1. OPENCODE_GO_API_KEY — your OpenCode Go subscription key
#   2. GBRAIN_DATABASE_URL — shared Postgres connection string over Tailscale
#   3. *_TAILNET_HOST placeholders — your tailnet Postgres/Ollama hostnames or IPs
#
# Then run: ./scripts/install-opencode-go.sh
#
# Routing under v0.27 AI Gateway:
#   - Chat (subagents) → opencode-go recipe → OpenCode Go OpenAI-compat /chat/completions
#   - Query expansion  → opencode-go recipe → same endpoint, cheaper model
#   - Embeddings       → ollama recipe → tailnet Ollama (Go has no embedding models)
#
# Model id format under v0.27 is "<recipe-id>:<model-id>", e.g. "opencode-go:kimi-k2.6"
# or "ollama:mxbai-embed-large". The installer writes these to ~/.gbrain/config.json.
# Direct OpenCode Go API model IDs remain raw (kimi-k2.6, deepseek-v4-flash, qwen3.6-plus).

# ── REQUIRED — per-client ────────────────────────────────────────────────

# OpenCode Go subscription API key. Get it from https://opencode.ai/zen
# after subscribing to the Go tier. The opencode-go recipe reads this from env
# at gateway-configure time; you do not need to write it to config.json.
OPENCODE_GO_API_KEY=REPLACE_WITH_OPENCODE_GO_KEY

# Postgres connection string for the shared Tailscale kbrain backend.
# Must include user, password, host, port, database. pgvector extension required.
# Example: postgresql://kbrain:***@postgres.your-tailnet.ts.net:5432/kbrain?sslmode=disable
GBRAIN_DATABASE_URL=postgresql://USER:PASSWORD@POSTGRES_TAILNET_HOST:5432/kbrain?sslmode=disable

# ── Gateway model selection ──────────────────────────────────────────────

# Subagent / chat model — drives Minions subagent loops.
GBRAIN_CHAT_MODEL=opencode-go:kimi-k2.6

# Query expansion model — cheap fast model used by hybrid search.
GBRAIN_EXPANSION_MODEL=opencode-go:deepseek-v4-flash

# Embedding model — Ollama serves an OpenAI-compatible embeddings endpoint.
GBRAIN_EMBEDDING_MODEL=ollama:mxbai-embed-large
GBRAIN_EMBEDDING_DIMENSIONS=1024

# ── Provider base URL overrides ──────────────────────────────────────────

# OpenCode Go default base URL is https://opencode.ai/zen/go/v1; only override
# if you proxy it. Leave commented to use the recipe default.
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# Tailnet Ollama base URL. The installer writes this into provider_base_urls.ollama
# in ~/.gbrain/config.json. Setup once on the shared Ollama host:
#   docker run -d --name ollama -p 11434:11434 -v /opt/ollama:/root/.ollama ollama/ollama
#   docker exec ollama ollama pull mxbai-embed-large
OLLAMA_BASE_URL=http://OLLAMA_TAILNET_HOST:11434/v1

# ── Optional — autopilot tuning ─────────────────────────────────────────

# Max concurrent OpenAI-compatible chat requests. Lower if Go rate-limits.
GBRAIN_ANTHROPIC_MAX_INFLIGHT=4

# Minion mode. `pain_triggered` is the default routing rule; `off` disables
# the durable job queue entirely (PGLite installs only).
# GBRAIN_MINION_MODE=pain_triggered
